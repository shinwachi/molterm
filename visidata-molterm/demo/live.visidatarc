# VisiData's settings for the live demo: the plugin, a plain screen, and then the lockdown, which must come last.
import sys
sys.path[:0] = ["/app", "/app/demo"]
import molterm_visidata  # noqa: E402,F401

options.disp_help_flags = ""
# the page's terminal shows Kitty graphics, under a name of its own (molterm-kitty, for its mouse) the plugin doesn't know
options.molterm_mode = "kitty"
# structures from the start, beside the smiles column, for visitors who don't know the keys yet
options.molterm_auto = True
options.molterm_auto_props = True
# every row at full height on every sheet, as on the rows a chart's cursor opens
options.disp_multiline_focus = False
# the web terminal's font has no ⁝, VisiData's separator inside tall rows
options.disp_rowmid_sep = "│"
options.disp_rowbot_sep = "│"
# a dark grey cursor row rather than reversed colours, under which light pictures would fade
options.color_current_row = "bold on 238"

import lockdown  # noqa: E402,F401
